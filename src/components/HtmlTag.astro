---
import HtmlTagAttribute from '@/components/HtmlTagAttribute.astro';

interface Props {
  tag: string;
  attributes?: Record<string, string>;
}

const { tag, attributes } = Astro.props;
const attributeEntries = attributes ? Object.entries(attributes) : [];
---

<span class="html-tag">&lt;{tag}{
    attributeEntries.map(([name, value]) => (
      <>
        {' '}<HtmlTagAttribute name={name} value={value} />
      </>
    ))
  }&gt;</span>

<style>
  .html-tag {
    color: #881280;

    @media (prefers-color-scheme: dark) {
      color: #5db0d7;
    }
  }
</style>
